# Local-only Compose interpolation file; copy to .env (the repository ignores .env and .env.*).
# PostgreSQL superuser password used only by the local postgres container.
POSTGRES_PASSWORD=dev-postgres-only-change-me
# Dedicated database login for auth-service.
AUTH_DB_PASSWORD=dev-auth-only-change-me
# Dedicated database login for subscription-service.
SUBSCRIPTION_DB_PASSWORD=dev-subscription-only-change-me
# Dedicated database login for facility-service.
FACILITY_DB_PASSWORD=dev-facility-only-change-me
# Dedicated database login for reporting-service.
REPORTING_DB_PASSWORD=dev-reporting-only-change-me
# Dedicated database login for discovery-service.
DISCOVERY_DB_PASSWORD=dev-discovery-only-change-me
# Dedicated database login for voucher-service.
VOUCHER_DB_PASSWORD=dev-voucher-only-change-me
# Dedicated database login for booking-service.
BOOKING_DB_PASSWORD=dev-booking-only-change-me
# Dedicated database login for payment-service.
PAYMENT_DB_PASSWORD=dev-payment-only-change-me
# Dedicated database login for staff-operations-service.
STAFF_DB_PASSWORD=dev-staff-only-change-me
# Dedicated database login reserved for optional POS.
POS_DB_PASSWORD=dev-pos-only-change-me
# Dedicated database login reserved for optional notifications.
NOTIFICATION_DB_PASSWORD=dev-notification-only-change-me
# Redis requirepass shared by local services.
REDIS_PASSWORD=dev-redis-only-change-me
# JWT issuer; must be identical for auth issuance and all validators.
AUTH_JWT_ISSUER=http://auth-service:8081
# Development key ID used by auth-service's ephemeral signing key when private key is blank.
AUTH_JWT_KEY_ID=local-dev-key
# Blank uses auth-service's documented ephemeral development signing key; never use this setting for production.
AUTH_JWT_PRIVATE_KEY=
# Shared booking hold verification credential; fake local value only (minimum 32 characters).
BOOKING_HOLD_SERVICE_TOKEN=dev-only-booking-hold-token-000000000000
# Booking integration credential; fake local value only.
BOOKING_INTEGRATION_TOKEN=dev-only-booking-integration-token-00000000
# Payment-to-booking internal credential; fake local value only.
PAYMENT_BOOKING_SERVICE_TOKEN=dev-only-payment-booking-token-0000000000
# Booking-to-facility reservation credential; fake local value only.
FACILITY_RESERVATION_TOKEN=dev-only-facility-reservation-token-0000000
# Facility/discovery internal slot contract credential; fake local value only.
DISCOVERY_INTERNAL_SLOT_TOKEN=dev-only-discovery-slot-token-000000000
# Staff-to-booking internal credential; fake local value only.
STAFF_BOOKING_SERVICE_TOKEN=dev-only-staff-booking-token-00000000000
# Signing secret used by offline staff operations; fake local value only.
STAFF_OFFLINE_SIGNING_KEY=dev-only-staff-offline-signing-key-000000000
# Optional POS-to-booking internal credential; fake local value only.
POS_BOOKING_SERVICE_TOKEN=dev-only-pos-booking-token-000000000000
# Optional POS settlement internal credential; fake local value only.
POS_SETTLEMENT_SERVICE_TOKEN=dev-only-pos-settlement-token-000000000
# Voucher gRPC internal credential; fake local value only.
VOUCHER_GRPC_TOKEN=dev-only-voucher-grpc-token-000000000000
# Optional PayOS client ID; blank disables subscription checkout until sandbox values are supplied.
PAYOS_CLIENT_ID=
# Optional PayOS API key; blank disables subscription checkout.
PAYOS_API_KEY=
# Optional PayOS checksum key; blank disables subscription checkout.
PAYOS_CHECKSUM_KEY=
# Optional PayOS return URL for a local sandbox flow.
PAYOS_RETURN_URL=http://localhost:8082/local-return
# Optional PayOS cancel URL for a local sandbox flow.
PAYOS_CANCEL_URL=http://localhost:8082/local-cancel
# Optional payment-service Cloudinary URL for receipt upload; blank means uploads may be unavailable.
CLOUDINARY_URL=
# Optional SMTP host used only with the notifications profile.
NOTIFICATION_SMTP_HOST=
# SMTP port used only with the notifications profile.
NOTIFICATION_SMTP_PORT=587
# Optional SMTP username used only with the notifications profile.
NOTIFICATION_SMTP_USER=
# Optional SMTP password used only with the notifications profile.
NOTIFICATION_SMTP_PASSWORD=
# Optional sender address used only with the notifications profile.
NOTIFICATION_MAIL_FROM=local@example.invalid
# Optional reset-password frontend URL used only with the notifications profile.
NOTIFICATION_RESET_PASSWORD_URL=http://localhost:8080/reset-password
