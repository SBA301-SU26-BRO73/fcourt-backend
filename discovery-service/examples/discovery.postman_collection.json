{
  "info": {
    "name": "FCOURT Discovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    }
  ],
  "item": [
    {
      "name": "List branches",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Fuzzy search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?query=sunrize"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Combined filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?city=Ho%20Chi%20Minh&district=Quan%201&courtTypeId=1&minPrice=150000&maxPrice=180000&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Distance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?latitude=10.762622&longitude=106.660172"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid coordinate pair",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?latitude=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}