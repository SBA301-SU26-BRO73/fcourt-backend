{
  "info": {
    "name": "FCOURT Discovery",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    }
  ],
  "item": [
    {
      "name": "Advanced filters - actual availability today",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?city=ho%20chi%20minh&district=quan%201&courtTypeId=1&minPrice=50000&maxPrice=150000&hasAvailableSlotsToday=true&timeSlot=18%3A00%20-%2020%3A00&page=0&size=20"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 200 with live dependencies\", () => pm.response.to.have.status(200));",
            "pm.test(\"Availability is not cached\", () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
          ]
        }
      }]
    },
    {
      "name": "List branches",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Fuzzy search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?query=sunrize"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Combined filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?city=Ho%20Chi%20Minh&district=Quan%201&courtTypeId=1&minPrice=150000&maxPrice=180000&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Distance",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?latitude=10.762622&longitude=106.660172"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid coordinate pair",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/branches?latitude=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
