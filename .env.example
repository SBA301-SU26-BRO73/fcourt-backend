POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Local S3 (LocalStack) used by auth, discovery, facility and payment. Real AWS uses the default credential
# chain (EKS Pod Identity); never put an access key in a config file.
LOCALSTACK_PORT=4566
STORAGE_S3_BUCKET=fcourt-local
# For a service running on the host against LocalStack:
# STORAGE_S3_ENDPOINT=http://localhost:4566
# STORAGE_PUBLIC_BASE_URL=http://localhost:4566/fcourt-local
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
