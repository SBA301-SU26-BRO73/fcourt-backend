POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# S3 for local Compose: a REAL AWS bucket, used by auth, discovery, facility, booking and payment (docs/storage-s3.md).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the key of IAM user `fcourt-local-s3` (ask the tech lead).
# Never commit .env (it is gitignored); never put a key in any tracked file.
STORAGE_S3_BUCKET=fcourt-local-media-870853685410
STORAGE_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Docker Compose cả hệ thống (docs/docker-compose.md). Ngoài khối S3 ở trên, mọi biến đều tuỳ chọn. ----
# Cổng mở ra máy host
GATEWAY_PORT=8080
EUREKA_PORT=8761
# KAFKA_HOST_PORT=9094
# REDIS_HOST_PORT=6387
# MAILPIT_UI_PORT=8025
# Giới hạn RAM mỗi service Java (heap tự tính bằng 55%)
# SERVICE_MEM_LIMIT=512m

# JWT: để trống thì auth-service tự tạo khoá ký tạm (restart auth là token cũ hết hiệu lực).
# AUTH_JWT_PRIVATE_KEY=
# AUTH_GOOGLE_CLIENT_ID=

# Tính năng cần tài khoản ngoài: để trống = tắt, hệ thống vẫn chạy.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# NOTIFICATION_SMTP_HOST=         # mặc định là Mailpit trong Compose
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASSWORD=

# Token nội bộ giữa các service đã có giá trị DEV trong docker-compose.yml; chỉ đặt lại nếu cần.
# BOOKING_HOLD_SERVICE_TOKEN=
