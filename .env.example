POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Local S3 (LocalStack) used by auth, discovery, facility and payment. Real AWS uses the default credential
# chain (EKS Pod Identity); never put an access key in a config file.
LOCALSTACK_PORT=4566
STORAGE_S3_BUCKET=fcourt-local
# For a service running on the host against LocalStack:
# STORAGE_S3_ENDPOINT=http://localhost:4566
# STORAGE_PUBLIC_BASE_URL=http://localhost:4566/fcourt-local
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ---- Docker Compose cả hệ thống (docs/docker-compose.md). Mọi biến đều tuỳ chọn, mặc định chạy được. ----
# Cổng mở ra máy host
GATEWAY_PORT=8080
EUREKA_PORT=8761
# KAFKA_HOST_PORT=9094
# REDIS_HOST_PORT=6387
# MAILPIT_UI_PORT=8025
# Giới hạn RAM mỗi service Java (heap tự tính bằng 55%)
# SERVICE_MEM_LIMIT=512m

# JWT: để trống thì auth-service tự tạo khoá ký tạm (restart auth là token cũ hết hiệu lực).
# AUTH_JWT_PRIVATE_KEY=
# AUTH_GOOGLE_CLIENT_ID=

# Tính năng cần tài khoản ngoài: để trống = tắt, hệ thống vẫn chạy.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# NOTIFICATION_SMTP_HOST=         # mặc định là Mailpit trong Compose
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASSWORD=

# Token nội bộ giữa các service đã có giá trị DEV trong docker-compose.yml; chỉ đặt lại nếu cần.
# BOOKING_HOLD_SERVICE_TOKEN=
