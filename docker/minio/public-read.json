{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadImagePrefixes",
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::__BUCKET__/avatars/*",
        "arn:aws:s3:::__BUCKET__/branches/*",
        "arn:aws:s3:::__BUCKET__/reviews/*"
      ]
    }
  ]
}
